PARSER_BEGIN(MiniKotlin)
import java.io.*;
public class MiniKotlin {

  public static void main(String args[]) throws ParseException,IOException {
    
 	MiniKotlin analisador = new MiniKotlin(new FileInputStream(args[0]));
 	analisador.Kotlin();
  }

}

PARSER_END(MiniKotlin)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

TOKEN :
{
  <MAIN: "main">
| <FN: "fun">  
| <LET: "var">
| <IF: "if">
| <WHILE: "while">
| <RETURN: "return">
| <PRINT: "print">
| <READFLOAT: "readFloat">
}

TOKEN :
{
  <APAR: "(">
| <FPAR: ")">  
| <BEGIN: "{">
| <END: "}">
| <COLON: ":">
| <SEMICOLON: ";">
| <ATRIB: "=">
| <COMMA: ",">
}

TOKEN : 
{
  <FLOAT: "Float">
| <BOOLEAN: "Boolean">
| <VOID: "Void">
}

TOKEN : 
{
  <TRUE: "true">
| <FALSE: "false">
}

TOKEN : 
{
  <PLUS: "+">
| <MINUS: "-">
| <STAR: "*">
| <SLASH: "/">
| <AND: "&&">
| <OR: "||">
| <LESSTHAN: "<">
| <MORETHAN: ">">
| <EQUALS: "==">
}


TOKEN :
{
  <NUM : (["0"-"9"])+ ("."(["0"-"9"])+)? ("E"("+"|"-")?(["0"-"9"])+)? >
| <ID: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"])* ("_"(["a"-"z","A"-"Z","0"-"9"])+)* >
}



void Kotlin () :
{Token t;}
{

(
  <MAIN> { System.out.println("Palavra reservada: main");}
| <FN>   { System.out.println("Palavra reservada: fun");}
| <LET> { System.out.println("Palavra reservada: var" );}
| t=<IF> { System.out.println("Palavra reservada: " + t.image );}
| t=<WHILE> { System.out.println("Palavra reservada: " + t.image );}
| t=<RETURN> { System.out.println("Palavra reservada: " + t.image );}
| t=<PRINT> { System.out.println("Palavra reservada: " + t.image );}
| t=<READFLOAT> { System.out.println("Palavra reservada: " + t.image );}
| <BEGIN> { System.out.println("Abre chaves: {") ;}
| <FPAR> { System.out.println("Fecha parênteses: )");}
| <APAR> { System.out.println("Abre parênteses: (");}
| <END>  { System.out.println("Fecha chaves: }" );}  
| <COLON>  { System.out.println("Dois pontos: :" );}
| <SEMICOLON>  { System.out.println("Ponto e virgula: ;" );}  
| t=<ATRIB> { System.out.println("Igual: " + t.image );}
| t=<FLOAT> { System.out.println("Tipo: " + t.image );}
| t=<BOOLEAN> { System.out.println("Tipo: " + t.image );}
| t=<VOID> { System.out.println("Tipo: " + t.image );}
| t=<NUM> { System.out.println("Número: "+ t.image);}
| t=<ID> { System.out.println("Identificador: "+ t.image);}
| t=<PLUS> { System.out.println("Operador: "+ t.image);}
| t=<MINUS> { System.out.println("Operador: "+ t.image);}
| t=<STAR> { System.out.println("Operador: "+ t.image);}
| t=<SLASH> { System.out.println("Operador: "+ t.image);}
| t=<AND> { System.out.println("Operador: "+ t.image);}
| t=<OR> { System.out.println("Operador: "+ t.image);}
| t=<LESSTHAN> { System.out.println("Operador: "+ t.image);}
| t=<MORETHAN> { System.out.println("Operador: "+ t.image);}
| t=<EQUALS> { System.out.println("Operador: "+ t.image);}
| t=<COMMA> { System.out.println("Virgula: "+ t.image);}
| t=<TRUE> { System.out.println("Booleano: "+ t.image);}
| t=<FALSE> { System.out.println("Booleano: "+ t.image);}
)*
<EOF> 


}





