PARSER_BEGIN(MiniKotlin)
import java.io.*;
public class MiniKotlin {

  public static void main(String args[]) throws ParseException,IOException {
    
 	MiniKotlin analisador = new MiniKotlin(new FileInputStream(args[0]));
 	//analisador.Kotlin();
  analisador.KotlinSintax();
  }

}

PARSER_END(MiniKotlin)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

TOKEN :
{
  <MAIN: "main">
| <FN: "fun">  
| <LET: "var">
| <IF: "if">
| <WHILE: "while">
| <RETURN: "return">
| <PRINT: "print">
| <READFLOAT: "readFloat">
}

TOKEN :
{
  <APAR: "(">
| <FPAR: ")">  
| <BEGIN: "{">
| <END: "}">
| <COLON: ":">
| <SEMICOLON: ";">
| <ATRIB: "=">
| <COMMA: ",">
}

TOKEN : 
{
  <FLOAT: "Float">
| <BOOLEAN: "Boolean">
| <VOID: "Void">
}

TOKEN : 
{
  <TRUE: "true">
| <FALSE: "false">
}

TOKEN : 
{
  <PLUS: "+">
| <MINUS: "-">
| <STAR: "*">
| <SLASH: "/">
| <AND: "&&">
| <OR: "||">
| <LESSTHAN: "<">
| <MORETHAN: ">">
| <EQUALS: "==">
}


TOKEN :
{
  <NUM : (["0"-"9"])+ ("."(["0"-"9"])+)? ("E"("+"|"-")?(["0"-"9"])+)? >
| <ID: ["a"-"z","A"-"Z"] ( ["a"-"z","A"-"Z","0"-"9"])* ("_"(["a"-"z","A"-"Z","0"-"9"])+)* >
}



void Kotlin () :
{Token t;}
{

(
  <MAIN> { System.out.println("Palavra reservada: main");}
| <FN>   { System.out.println("Palavra reservada: fun");}
| <LET> { System.out.println("Palavra reservada: var" );}
| t=<IF> { System.out.println("Palavra reservada: " + t.image );}
| t=<WHILE> { System.out.println("Palavra reservada: " + t.image );}
| t=<RETURN> { System.out.println("Palavra reservada: " + t.image );}
| t=<PRINT> { System.out.println("Palavra reservada: " + t.image );}
| t=<READFLOAT> { System.out.println("Palavra reservada: " + t.image );}
| <BEGIN> { System.out.println("Abre chaves: {") ;}
| <FPAR> { System.out.println("Fecha parênteses: )");}
| <APAR> { System.out.println("Abre parênteses: (");}
| <END>  { System.out.println("Fecha chaves: }" );}  
| <COLON>  { System.out.println("Dois pontos: :" );}
| <SEMICOLON>  { System.out.println("Ponto e virgula: ;" );}  
| t=<ATRIB> { System.out.println("Igual: " + t.image );}
| t=<FLOAT> { System.out.println("Tipo: " + t.image );}
| t=<BOOLEAN> { System.out.println("Tipo: " + t.image );}
| t=<VOID> { System.out.println("Tipo: " + t.image );}
| t=<NUM> { System.out.println("Número: "+ t.image);}
| t=<ID> { System.out.println("Identificador: "+ t.image);}
| t=<PLUS> { System.out.println("Operador: "+ t.image);}
| t=<MINUS> { System.out.println("Operador: "+ t.image);}
| t=<STAR> { System.out.println("Operador: "+ t.image);}
| t=<SLASH> { System.out.println("Operador: "+ t.image);}
| t=<AND> { System.out.println("Operador: "+ t.image);}
| t=<OR> { System.out.println("Operador: "+ t.image);}
| t=<LESSTHAN> { System.out.println("Operador: "+ t.image);}
| t=<MORETHAN> { System.out.println("Operador: "+ t.image);}
| t=<EQUALS> { System.out.println("Operador: "+ t.image);}
| t=<COMMA> { System.out.println("Virgula: "+ t.image);}
| t=<TRUE> { System.out.println("Booleano: "+ t.image);}
| t=<FALSE> { System.out.println("Booleano: "+ t.image);}
)*
<EOF> 

}


// KOTLIN -> MAIN FUNC?

void KotlinSintax():
{}
{
  { System.out.println("Início da análise sintática"); }
  MAIN() (FUNC())?
  <EOF>
  { System.out.println("Análise sintática concluída com sucesso"); }
}

// MAIN -> "fun" "main" "(" ")" "{" VARDECL SEQCOMANDOS "}"

void MAIN() :
{}
{
  <FN> <MAIN> { System.out.println("Função main"); }
  <APAR> <FPAR> <BEGIN> VARDECL() SEQCOMANDOS() <END>
  { System.out.println("Fim da função main"); }
}

// VARDECL -> "var" TOKEN_id ":" TIPO ";" VARDECL | vazio

void VARDECL() :
{ Token t; }
{
  ( <LET> t=<ID> { System.out.println("Declaração de variável: " + t.image); }
    <COLON> TIPO() <SEMICOLON> VARDECL() )?
}

// TIPO -> "Float" | "Boolean" | "Void"

void TIPO() :
{ Token t; }
{
  ( t=<FLOAT> | t=<BOOLEAN> | t=<VOID> )
  { System.out.println("Tipo: " + t.image); }
}

// SEQCOMANDOS -> COMANDO SEQCOMANDOS | vazio

void SEQCOMANDOS() :
{}
{
  ( COMANDO() SEQCOMANDOS() )?
}

// COMANDO -> TOKEN_id COMANDOLINHA
// | "if" EXP "{" SEQCOMANDOS "}" ";"
// | "while" EXP "{" SEQCOMANDOS "}" ";"
// | "return" EXP ";"
// | "print" EXP ";"

void COMANDO() :
{ Token t; }
{
    ( t=<ID> { System.out.println("Comando com identificador: " + t.image); } COMANDOLINHA() )
  | ( <IF> { System.out.println("Comando: if"); } EXP() <BEGIN> SEQCOMANDOS() <END> <SEMICOLON> )
  | ( <WHILE> { System.out.println("Comando: while"); } EXP() <BEGIN> SEQCOMANDOS() <END> <SEMICOLON> )
  | ( <RETURN> { System.out.println("Comando: return"); } EXP() <SEMICOLON> )
  | ( <PRINT> { System.out.println("Comando: print"); } EXP() <SEMICOLON> )
}

// COMANDOLINHA -> "(" LISTAEXP? ")" ";" | "=" COMANDOLINHALINHA

void COMANDOLINHA() :
{}
{
    ( <APAR> { System.out.println("  Chamada de função"); } ( LISTAEXP() )? <FPAR> <SEMICOLON> )
  | ( <ATRIB> { System.out.println("  Atribuição"); } COMANDOLINHALINHA() )
}

// COMANDOLINHALINHA -> EXP ";" | "readFloat" "(" ")" ";"

void COMANDOLINHALINHA() :
{}
{
    ( EXP() <SEMICOLON> )
  | ( <READFLOAT> { System.out.println("  readFloat"); } <APAR> <FPAR> <SEMICOLON> )
}

// EXP -> "(" EXP OP EXP ")" | FATOR

void EXP() :
{}
{
    ( <APAR> { System.out.println("Expressão com operação"); } EXP() OP() EXP() <FPAR> )
  | FATOR()
}

// FATOR -> TOKEN_id FATORLINHA | TOKEN_numliteral | "true" | "false"

void FATOR() :
{ Token t; }
{
    ( t=<ID> { System.out.println("Fator id: " + t.image); } FATORLINHA() )
  | t=<NUM>   { System.out.println("Fator número: " + t.image); }
  | t=<TRUE>  { System.out.println("Fator booleano: " + t.image); }
  | t=<FALSE> { System.out.println("Fator booleano: " + t.image); }
}

// FATORLINHA -> "(" LISTAEXP? ")" | vazio

void FATORLINHA() :
{}
{
  ( <APAR> { System.out.println("Fator: chamada de função"); } (LISTAEXP())? <FPAR> )?
}

// OP -> "+" | "-" | "*" | "/" | "&&" | "||" | "<" | ">" | "=="

void OP() :
{ Token t; }
{
  ( t=<PLUS> | t=<MINUS> | t=<STAR> | t=<SLASH> | t=<AND> | t=<OR>
  | t=<LESSTHAN> | t=<MORETHAN> | t=<EQUALS> )
  { System.out.println("Operador: " + t.image); }
}

// LISTAEXP -> EXP LISTAEXPLINHA

void LISTAEXP() :
{}
{
  EXP() LISTAEXPLINHA()
}

// LISTAEXPLINHA -> "," LISTAEXP | vazia

void LISTAEXPLINHA() :
{}
{
  ( <COMMA> LISTAEXP() )?
}

// FUNC -> "fun" FUNCLINHA

void FUNC() :
{}
{
  <FN> FUNCLINHA()
}

// FUNCLINHA -> TOKEN_id "(" LISTAARG? ")" ":" TIPO "{" VARDECL SEQCOMANDOS "}" FUNCLINHALINHA

void FUNCLINHA() :
{ Token t; }
{
  t=<ID> { System.out.println("Função: " + t.image); }
  <APAR> (LISTAARG())? <FPAR> <COLON> TIPO() <BEGIN> VARDECL() SEQCOMANDOS() <END>
  { System.out.println("Fim da função: " + t.image); }
  FUNCLINHALINHA()
}

// FUNCLINHALINHA -> FUNC | vazio

void FUNCLINHALINHA() :
{}
{
  ( FUNC() )?
}

// LISTAARG -> TOKEN_id ":" TIPO LISTAARGLINHA

void LISTAARG() :
{ Token t; }
{
  t=<ID> { System.out.println("Parâmetro: " + t.image); }
  <COLON> TIPO() LISTAARGLINHA()
}

// LISTAARGLINHA -> "," LISTAARG | vazio

void LISTAARGLINHA() :
{}
{
  ( <COMMA> LISTAARG() )?
}
